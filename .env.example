# ----------------------------------------
# CivicFix Environment Configuration
# ----------------------------------------

# Application Environment
NODE_ENV=production
PORT=3000
ENVIRONMENT=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://civicfix:civicfix_secret@postgres:5432/civicfix_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=civicfix
DB_PASSWORD=civicfix_secret
DB_NAME=civicfix_db

# Cache & Background Worker (Redis)
REDIS_URL=redis://redis:6379/0

# Security & Tokens
JWT_SECRET=civicfix-production-secure-jwt-key-2026-supersecret
JWT_REFRESH_SECRET=civicfix-production-refresh-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Gemini API)
GEMINI_API_KEY=
API_KEY=

# Object Storage (S3 / MinIO compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=civicfix-evidence
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Email Notification Server (SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Client API URLs
VITE_API_URL=/api
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Backend Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
